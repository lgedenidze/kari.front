# Where the .NET API lives. Server-side only: the browser always calls this site's own /api/*,
# which is proxied to the API, so the session cookie stays same-origin.
API_URL=http://localhost:5080

# The public address of this site. Used for canonical links, the sitemap and invite links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# "Add to Apple Wallet": the bar's Pass Type ID certificate from Apple, as a .p12 in base64,
# and its password. Secrets: set them in the Vercel project, never here. With neither set the
# app has no Wallet button. scripts/wallet-certificate.sh makes and installs them.
# APPLE_PASS_P12=
# APPLE_PASS_P12_PASSWORD=
